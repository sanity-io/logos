{
  "name": "sanity-logos-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "scripts": {
    "build": "pnpm --filter @sanity/logos build",
    "changeset": "changeset",
    "clean": "pnpm --recursive clean",
    "dev": "pnpm --filter sanity-logos-storybook dev",
    "format": "oxfmt . --no-error-on-unmatched-pattern",
    "knip": "knip --treat-config-hints-as-errors",
    "lint": "pnpm run oxlint",
    "lint:fix": "pnpm lint --fix --fix-suggestions",
    "oxlint": "oxlint --disable-nested-config",
    "release": "changeset publish",
    "storybook:build": "pnpm --filter sanity-logos-storybook build",
    "test:browser": "pnpm --filter sanity-logos-storybook test",
    "watch": "pnpm --filter @sanity/logos watch"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "catalog:",
    "eslint-plugin-storybook": "^10.6.0",
    "knip": "^6.38.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.6.0"
}
